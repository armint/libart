# libArT/cmake/art-coreConfig.cmake.in
@PACKAGE_INIT@

# Ensure dependencies are available before loading the targets they reference
include(CMakeFindDependencyMacro)

# Dependencies providing the following targets used by art-core:
#   - etl::etl (package: etl)
#   - ArduinoJson (package: ArduinoJson)
find_dependency(etl)
find_dependency(ArduinoJson)

# Load the exported targets for this package (installed by install(EXPORT ...))
include("${CMAKE_CURRENT_LIST_DIR}/art-core-targets.cmake")

# ETL is a PUBLIC dependency of art::core (utils/compat/span.h aliases etl::span), but the export cannot link it,
# because the build links the etl target of FetchContent (see CMakeLists.txt). Link the installed etl::etl here, so
# that a consumer of art::core gets the ETL include path, as with add_subdirectory(). The guard keeps a second
# find_package(art-core) in the same directory from adding it twice.
get_target_property(_art_core_links art::core INTERFACE_LINK_LIBRARIES)
if (NOT "etl::etl" IN_LIST _art_core_links)
    set_property(TARGET art::core APPEND PROPERTY INTERFACE_LINK_LIBRARIES etl::etl)
endif ()
unset(_art_core_links)

# Make shared CMake utility functions available to consumers immediately.
# After find_package(art-core), callers can use:
#   art_setup_build_config()  — from BuildConfig.cmake
#   ADD_DUMP_TARGET()         — from output_files.cmake
#   PRINT_SIZE_OF_TARGETS()   — from output_files.cmake
# generate_version.cmake is installed alongside these files but must be
# included explicitly because it executes git describe at configure time.
include("${CMAKE_CURRENT_LIST_DIR}/BuildConfig.cmake")
include("${CMAKE_CURRENT_LIST_DIR}/output_files.cmake")

# Optional: ensure all requested components are found (if you define any)
check_required_components(art-core)